# Copy to .env and fill in values before running.
# docker compose up --build

# LLM provider key (set the one that matches REVIEW_MODEL)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# provider:modelId — switch freely via the AI SDK
# Escalate with openai:gpt-5.6-terra if review quality is weak
REVIEW_MODEL=openai:gpt-5.6-luna

# Set to 1 to log raw provider request/response bodies from generateText
# INCLUDE_DEBUG_BODY=1

# Set to 1 to capture AI SDK runs for DevTools (npm run devtools → http://localhost:4983)
# AI_SDK_DEVTOOLS=1

# Local SQLite database. Docker Compose overrides this with its shared volume path.
DATABASE_URL=file:./data/dev.db
